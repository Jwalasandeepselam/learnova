# Copy to backend/.env. Use the same hostname for frontend and API cookies.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LIVE_MODEL=gemini-3.8-live
MAX_UPLOAD_MB=20
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# Relative paths resolve from the repository root.
STORAGE_DIR=storage
LEARNING_DB_PATH=storage/learning.db
# Supabase production mode. These backend-only values belong in backend/.env or
# your deployment secret store; never prefix the database URL or service role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_STORAGE_BUCKET=learning-materials
# Browser-safe values go in frontend/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
